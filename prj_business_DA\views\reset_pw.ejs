<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>비밀번호 변경</title>
  <style>
    body {
      background: #f3f6fb;
      font-family: 'Segoe UI', sans-serif;
    }
    .container {
      max-width: 400px;
      margin: 40px auto;
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
    }
    h2 { margin-bottom: 20px; }
    .input-field {
      width: 100%;
      margin-bottom: 10px;
      padding: 8px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    .btn-submit {
      width: 100%;
      background: #e67e22;
      color: white;
      padding: 10px;
      font-weight: bold;
      border: none;
      border-radius: 6px;
      cursor: pointer;
    }
    .info-label {
      font-weight: bold;
      margin-bottom: 6px;
    }
  </style>
  <script>
    async function resetPassword() {
      const id = document.getElementById('userid').innerText;
      const newPw = document.getElementById('newPw').value;
      const confirmPw = document.getElementById('confirmPw').value;

      if (!newPw || !confirmPw) {
        alert("비밀번호는 영문+숫자 조합으로 8~16자 사이여야 합니다.");
        return;
      }

      const res = await fetch('/api/v1/reset_pw', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, newPw, confirmPw })
      });

      const result = await res.text();
      alert(result);
      if (res.ok) location.href = '/login';
    }
  </script>
</head>
<body>
  <div class="container">
    <h2>비밀번호 변경</h2>
    <p class="info-label">ID: <span id="userid"><%= id %></span></p>
    <input id="newPw" type="password" class="input-field" placeholder="새 비밀번호 입력" />
    <input id="confirmPw" type="password" class="input-field" placeholder="비밀번호 확인" />
    <button onclick="resetPassword()" class="btn-submit">변경하기</button>
  </div>
</body>
</html>
